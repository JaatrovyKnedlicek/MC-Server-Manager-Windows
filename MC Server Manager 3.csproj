<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>MC_Server_Manager_3</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>assets\ikona.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <Title>MC Server Manager 3</Title>
    <Version>3.2</Version>
    <Company>Ján Repka</Company>
    <Authors>Ján Repka</Authors>
    <Copyright>© Ján Repka 2026</Copyright>
    <PackageProjectUrl>https://github.com/JaatrovyKnedlicek/MC-Server-Manager-Windows</PackageProjectUrl>
    <Description>Lighweight manager for locally hosted Minecraft PaperMC Servers.</Description>
    <RepositoryUrl>https://github.com/JaatrovyKnedlicek/MC-Server-Manager-Windows</RepositoryUrl>
    <AssemblyVersion>3.2</AssemblyVersion>
    <FileVersion>3.2</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="paper-versions.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\ikona.ico" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="paper-versions.json" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include=".github\ISSUE_TEMPLATE\" />
    <Folder Include=".github\workflows\" />
    <Folder Include="wiki\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Open.NAT" Version="2.1.0" />
  </ItemGroup>

</Project>